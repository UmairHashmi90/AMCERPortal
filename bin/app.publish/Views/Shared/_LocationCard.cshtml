@model ERPaperless.Models.LocationCardViewModel
@using System
@{
    var iconSrc = Url.Content(Model.IsChair ? "~/Assets/Images/chair.png" : "~/Assets/Images/bed.png");
    var iconAlt = Model.IsChair ? "Chair" : "Bed";
    var isMo = ViewBag.IsMO == true;
    var isNursing = ViewBag.IsNursing == true;
    var isNursingOnly = isNursing && !isMo && ViewBag.IsPharmacy != true && ViewBag.IsBilling != true;
    var hideReportsAndPrescriptions = ViewBag.IsPharmacyOnly == true || ViewBag.IsBillingOnly == true || isNursingOnly;
    var dischargedList = ViewBag.IsDischargedPatientsPage == true;
    var formRoute = dischargedList
        ? (object)new { patientId = Model.PatientId, returnTo = "discharged" }
        : new { patientId = Model.PatientId };
    var reportsRoute = dischargedList
        ? (object)new { admissionCode = Model.AdmissionCode, returnTo = "discharged" }
        : new { admissionCode = Model.AdmissionCode };
    var showCancelPendingMr = ViewBag.IsBilling == true
        && !dischargedList
        && !Model.HasAdmission
        && string.Equals((Model.StateLabel ?? "").Trim(), "Pending MR", StringComparison.OrdinalIgnoreCase);
}

<article class="location-card @Model.ResolvedCardBackgroundClass">
    <header class="location-head">
        <img src="@iconSrc" alt="@iconAlt" class="slot-type-icon" />
        <h4>@Model.SlotName</h4>
        <div class="location-head-end">
            <span class="status-chip @Model.StateClass">@Model.StateLabel</span>
            @if (showCancelPendingMr)
            {
                <button type="button"
                        class="location-bin-btn cancel-pending-mr-btn"
                        title="Cancel Pending MR"
                        aria-label="Cancel Pending MR"
                        data-bedid="@Model.BedId"
                        data-branchcode="@Model.BranchCode"
                        data-bedname="@Model.SlotName"
                        data-patientname="@Model.PatientName">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                    </svg>
                </button>
            }
        </div>
    </header>

    <div class="location-body">
        <p><strong>Patient Name: @Model.PatientName</strong></p>
        <p><strong>PMR#: @Model.MrNo</strong></p>
        <p><strong>Admission#:</strong> @Model.AdmissionNo</p>
        <p><strong>Age/Gender:</strong> @Model.AgeGender</p>


        <p>
            <strong>Admission On:</strong> @(Model.AdmissionDate.HasValue
            ? Model.AdmissionDate.Value.ToString("dd/MM/yyyy HH:mm")
            : "-")
        </p>
    </div>

    <div class="location-actions">

        @if (Model.StateClass == "status-green")
        {
            @* Available bed — only MO / Nursing may open *@
            if (ViewBag.CanAssignBed == true)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-danger open-bed-btn"
                        data-bedid="@Model.BedId"
                        data-branchcode="@Model.BranchCode"
                        data-admcode="@Model.AdmissionCode"
                        data-bedname="@Model.SlotName"
                        data-status="@Model.StateLabel">
                    Get Patient
                </button>
            }
        }
        else if (Model.ShowViewFormAction)
        {
            <div class="location-form-actions">
                @Html.ActionLink("View Form", "ErForm", "EmergencyForm",
                    formRoute,
                    new { @class = "btn btn-sm btn-danger" })
                @if (Model.HasAdmission && (dischargedList || !hideReportsAndPrescriptions))
                {
                    @Html.ActionLink("Reports", "Index", "Reports",
                        reportsRoute,
                        new { @class = "btn btn-sm btn-outline-primary" })
                    @Html.ActionLink("Prescriptions", "Prescription", "Reports",
                        reportsRoute,
                        new { @class = "btn btn-sm btn-outline-primary" })
                }
            </div>
        }

    </div>
</article>
