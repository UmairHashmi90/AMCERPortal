<div class="legend-inline work-queue-status-filters mb-2" data-default-filter="pending">
    <button type="button" class="status-chip status-purple status-chip-filter" data-filter="all">ALL</button>
    <button type="button" class="status-chip status-orange status-chip-filter active" data-filter="pending">Pending</button>
    <button type="button" class="status-chip status-green status-chip-filter" data-filter="completed">Completed</button>
    <button type="button" class="status-chip status-red status-chip-filter" data-filter="cancelled">Cancelled</button>
</div>
