@model ERPaperless.Models.ReportsPatientFormViewModel
@{
    ViewBag.Title = "Reports – " + Model.Patient.PatientName;
}

<section class="page-section">
    @Html.Partial("~/Views/Shared/_PatientFormNav.cshtml", Model.Patient)

    <div class="section-head">
        <h2>Reports</h2>
    </div>

    <article class="panel-card">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-12">
                <label class="form-label mb-1" for="reportSearchInput">Filter Reports by Name</label>
                <input type="search"
                       id="reportSearchInput"
                       class="form-control form-control-sm"
                       placeholder="Search test/report name..." />
            </div>
        </div>
        @Html.Partial("~/Views/Reports/_InvestigationsTable.cshtml", Model.Investigations)
        <p id="reportsFilterEmpty" class="text-muted small mb-0 mt-2 d-none">No reports match the selected filter.</p>
    </article>
</section>

<div class="modal fade" id="reportPreviewModal" tabindex="-1" aria-labelledby="reportPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reportPreviewModalLabel">Report Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <p class="text-muted mb-0" id="reportPreviewInfo">PDF preview will be shown here.</p>
                    <div class="pdf-preview-actions d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnReportPrint" disabled>Print</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnReportShare" disabled>Share</button>
                    </div>
                </div>
                <div id="reportPreviewCanvasHost" class="pdf-preview-host"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
(function () {
    "use strict";

    if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    }

    var currentRenderToken = 0;
    var currentPdfBlob = null;
    var currentPdfTitle = "Report.pdf";
    var searchInput = document.getElementById("reportSearchInput");
    var table = document.getElementById("reportsInvestigationsTable");
    var emptyEl = document.getElementById("reportsFilterEmpty");
    var rows = table ? table.querySelectorAll("tbody .report-data-row") : [];
    var modalEl = document.getElementById("reportPreviewModal");
    var infoEl = document.getElementById("reportPreviewInfo");
    var canvasHostEl = document.getElementById("reportPreviewCanvasHost");
    var printBtn = document.getElementById("btnReportPrint");
    var shareBtn = document.getElementById("btnReportShare");

    function setActionButtonsEnabled(enabled) {
        if (printBtn) printBtn.disabled = !enabled;
        if (shareBtn) shareBtn.disabled = !enabled;
    }

    function clearPdfCanvas() {
        if (canvasHostEl) canvasHostEl.innerHTML = "";
        currentPdfBlob = null;
        setActionButtonsEnabled(false);
    }

    function isPdfBuffer(buffer) {
        if (!buffer || buffer.byteLength < 4) return false;
        var bytes = new Uint8Array(buffer);
        return bytes[0] === 0x25 && bytes[1] === 0x50 && bytes[2] === 0x44 && bytes[3] === 0x46;
    }

    function safeFileName(name) {
        var base = String(name || "Report").replace(/[\\/:*?"<>|]+/g, " ").trim();
        if (!base) base = "Report";
        return base + (/\.pdf$/i.test(base) ? "" : ".pdf");
    }

    function renderPdfBuffer(buffer) {
        if (!window.pdfjsLib) {
            return Promise.reject(new Error("PDF engine is not loaded."));
        }
        if (!canvasHostEl) {
            return Promise.reject(new Error("PDF preview host not found."));
        }
        if (!isPdfBuffer(buffer)) {
            return Promise.reject(new Error("Invalid PDF data received."));
        }

        if (canvasHostEl) canvasHostEl.innerHTML = "";
        var renderToken = ++currentRenderToken;
        var loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(buffer) });

        return loadingTask.promise.then(function (pdf) {
            var renderSequentially = Promise.resolve();
            for (var pageNo = 1; pageNo <= pdf.numPages; pageNo++) {
                (function (pageNumber) {
                    renderSequentially = renderSequentially.then(function () {
                        if (renderToken !== currentRenderToken) return;
                        return pdf.getPage(pageNumber).then(function (page) {
                            if (renderToken !== currentRenderToken) return;

                            var containerWidth = Math.max((canvasHostEl.clientWidth || 1000) - 20, 280);
                            var initialViewport = page.getViewport({ scale: 1 });
                            var scale = containerWidth / initialViewport.width;
                            var viewport = page.getViewport({ scale: scale });
                            var outputScale = Math.min(window.devicePixelRatio || 1, 2);

                            var wrapper = document.createElement("div");
                            wrapper.style.marginBottom = "10px";
                            wrapper.style.background = "#fff";
                            wrapper.style.border = "1px solid #dee2e6";
                            wrapper.style.borderRadius = "6px";
                            wrapper.style.padding = "6px";

                            var canvas = document.createElement("canvas");
                            canvas.style.width = "100%";
                            canvas.style.height = "auto";
                            canvas.width = Math.floor(viewport.width * outputScale);
                            canvas.height = Math.floor(viewport.height * outputScale);
                            wrapper.appendChild(canvas);
                            canvasHostEl.appendChild(wrapper);

                            return page.render({
                                canvasContext: canvas.getContext("2d"),
                                viewport: viewport,
                                transform: outputScale === 1 ? null : [outputScale, 0, 0, outputScale, 0, 0]
                            }).promise;
                        });
                    });
                })(pageNo);
            }
            return renderSequentially;
        });
    }

    function printCurrentPdf() {
        if (!currentPdfBlob) return;
        var url = URL.createObjectURL(currentPdfBlob);
        var frame = document.createElement("iframe");
        frame.style.position = "fixed";
        frame.style.right = "0";
        frame.style.bottom = "0";
        frame.style.width = "0";
        frame.style.height = "0";
        frame.style.border = "0";
        frame.src = url;
        document.body.appendChild(frame);
        frame.onload = function () {
            try {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            } catch (err) {
                window.open(url, "_blank");
            }
            setTimeout(function () {
                URL.revokeObjectURL(url);
                if (frame.parentNode) frame.parentNode.removeChild(frame);
            }, 60000);
        };
    }

    function shareCurrentPdf() {
        if (!currentPdfBlob) return;
        var fileName = safeFileName(currentPdfTitle);
        var file = new File([currentPdfBlob], fileName, { type: "application/pdf" });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
            navigator.share({
                files: [file],
                title: currentPdfTitle,
                text: currentPdfTitle
            }).catch(function () { /* user cancelled */ });
            return;
        }

        var url = URL.createObjectURL(currentPdfBlob);
        var link = document.createElement("a");
        link.href = url;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
        if (infoEl) {
            var previous = infoEl.textContent;
            infoEl.textContent = previous + " — downloaded for sharing.";
            setTimeout(function () { if (infoEl) infoEl.textContent = previous; }, 2500);
        }
    }

    function applyReportFilters() {
        if (!table || !searchInput || !emptyEl || !rows.length) return;

        var term = (searchInput.value || "").trim().toLowerCase();
        var visibleCount = 0;

        rows.forEach(function (row) {
            var reportName = row.getAttribute("data-name") || "";
            var show = !term || reportName.indexOf(term) >= 0;
            row.classList.toggle("d-none", !show);
            if (show) visibleCount++;
        });

        emptyEl.classList.toggle("d-none", visibleCount > 0);
    }

    if (searchInput) {
        searchInput.addEventListener("input", applyReportFilters);
    }
    if (printBtn) printBtn.addEventListener("click", printCurrentPdf);
    if (shareBtn) shareBtn.addEventListener("click", shareCurrentPdf);

    document.addEventListener("click", function (e) {
        var btn = e.target.closest(".open-report-modal-btn");
        if (!btn) return;

        if (!modalEl || !infoEl || !canvasHostEl || !window.bootstrap || !window.bootstrap.Modal) return;

        var reportName = btn.getAttribute("data-report-name") || "Report";
        var reportUrl = btn.getAttribute("data-report-url") || "";
        currentPdfTitle = reportName;
        infoEl.textContent = reportName;

        var modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        clearPdfCanvas();

        if (!reportUrl) {
            infoEl.textContent = reportName + " not available.";
            return;
        }

        infoEl.textContent = "Loading " + reportName + "...";
        fetch(reportUrl, {
            credentials: "same-origin",
            headers: { "Accept": "application/pdf" }
        })
            .then(function (response) {
                if (!response.ok) throw new Error("Could not load report.");
                return response.arrayBuffer();
            })
            .then(function (buffer) {
                currentPdfBlob = new Blob([buffer], { type: "application/pdf" });
                return renderPdfBuffer(buffer);
            })
            .then(function () {
                infoEl.textContent = reportName;
                setActionButtonsEnabled(true);
            })
            .catch(function () {
                currentPdfBlob = null;
                setActionButtonsEnabled(false);
                infoEl.textContent = "Could not display PDF preview in this device/browser.";
            });
    });

    if (modalEl) {
        modalEl.addEventListener("hidden.bs.modal", function () {
            currentRenderToken++;
            clearPdfCanvas();
        });
    }
})();
</script>
