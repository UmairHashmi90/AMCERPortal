@model IEnumerable<ERPaperless.Models.LocationCardViewModel>
@{
    ViewBag.Title = "Patients";
}

@* ── Toast notifications ─────────────────────────────────────────────────── *@
@if (TempData["AccessError"] != null)
{
    <div class="alert alert-warning alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Access Denied:</strong> @TempData["AccessError"]
    </div>
}
@if (TempData["AssignSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Success!</strong> @TempData["AssignSuccess"]
    </div>
}
@if (TempData["AssignError"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Error:</strong> @TempData["AssignError"]
    </div>
}

<section class="page-section">

    <div class="toolbar-row patients-toolbar">
        <input type="text" class="form-control quick-input"
               id="bedSearch" placeholder="Search by Name / MR No / Bed" />
        <div class="patients-module-actions">
            @if (ViewBag.IsPharmacy == true)
            {
                @Html.ActionLink("Pharmacy", "PatientForm", "Pharmacy", null,
                         new { @class = "btn btn-sm patient-form-nav-btn btn-outline-danger" })
            }
            @if (ViewBag.IsBilling == true)
            {
                @Html.ActionLink("Billing", "PatientForm", "Billing", null,
                         new { @class = "btn btn-sm patient-form-nav-btn btn-outline-danger" })
            }
           
        </div>
        <div class="legend-inline">
            <span class="status-chip status-red">Occupied</span>
            <span class="status-chip status-orange">Pending MR</span>
            <span class="status-chip status-green">Available</span>
            <span class="status-chip status-purple">Housekeeping</span>
            <span class="status-chip status-gray">Closed</span>
        </div>
    </div>

    <div class="location-grid" id="locationGrid">
        @foreach (var bed in Model)
        {
            @Html.Partial("_LocationCard", bed)
        }
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   Pending MR Confirmation Modal – fires when View Form clicked on a free bed
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="pendingMrModal" tabindex="-1" role="dialog"
     aria-labelledby="pendingMrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            @using (Html.BeginForm("MarkBedPending", "Home", FormMethod.Post,
                    new { id = "frmPendingMr" }))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" id="pmBedId"      name="bedId"          value="0" />
                <input type="hidden" id="pmBranchCode" name="branchCode"     value="0" />

                <div class="modal-header">
                    <h4 class="modal-title" id="pendingMrModalLabel">
                        Open Bed for Patient
                    </h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        <strong><span id="pmBedNameSpan"></span></strong>
                        is currently
                        <span class="text-muted" id="pmStatusSpan"></span>.
                    </p>
                    <p>
                        Are you sure you want to open this bed for an
                        <strong>emergency patient</strong>?
                    </p>
                    <div class="form-group">
                        <label for="pmPatientName">Patient Name <small class="text-muted">(optional)</small></label>
                        <input type="text"
                               class="form-control"
                               id="pmPatientName"
                               name="patientName"
                               maxlength="100"
                               placeholder="Leave blank to use BED code" />
                    </div>
                    <p class="text-muted small mb-0">
                        The bed status will be set to <strong>Pending MR</strong>
                        and the ER Form will open immediately.
                        Patient details can be entered in the form.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default"
                            data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        Yes, Open Bed
                    </button>
                </div>
            }

        </div>
    </div>
</div>

@section scripts {
<script>
    // ── Quick search / filter beds ────────────────────────────────────────────
    document.getElementById('bedSearch').addEventListener('keyup', function () {
        var term = this.value.toLowerCase();
        document.querySelectorAll('#locationGrid .location-card').forEach(function (card) {
            card.style.display = card.textContent.toLowerCase().indexOf(term) >= 0
                ? '' : 'none';
        });
    });

    // ── Open Bed (View Form on unoccupied) – populate and open confirm modal ──
    document.querySelectorAll('.open-bed-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('pmBedId').value         = this.getAttribute('data-bedid');
            document.getElementById('pmBranchCode').value    = this.getAttribute('data-branchcode');
            document.getElementById('pmBedNameSpan').textContent   = this.getAttribute('data-bedname');
            document.getElementById('pmStatusSpan').textContent    = this.getAttribute('data-status');
            document.getElementById('pmPatientName').value = '';
            $('#pendingMrModal').modal('show');
        });
    });
</script>
}
