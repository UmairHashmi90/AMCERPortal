@model ERPaperless.Models.PharmacyPackageOrdersGridViewModel
@{
    bool canWork = ViewBag.CanWorkOnPage == true || ViewBag.CanChargePharmacyOrders == true;
    var orders = (Model?.Orders ?? new List<ERPaperless.Models.PackageOrderRowViewModel>())
        .OrderByDescending(x => x.RequestedOn)
        .ToList();
    var tableId = string.IsNullOrWhiteSpace(Model?.TableId) ? "pharmacyPackageTable" : Model.TableId;
    var bodyId = string.IsNullOrWhiteSpace(Model?.BodyId) ? "pharmacyPackageBody" : Model.BodyId;
    var showPatient = Model?.ShowPatientColumns == true;
    var colCount = showPatient ? 13 : 10;
}

<section class="panel-card pharmacy-pkg-panel mb-3">
    <div class="section-head mb-2">
        <h3 class="mb-1">@(Model?.Title ?? "Package Orders")</h3>
        @if (!string.IsNullOrWhiteSpace(Model?.Description))
        {
            <p class="text-muted small mb-0">@Model.Description</p>
        }
    </div>

    <div class="table-wrap grid-max-7">
        <table class="app-table pharmacy-pkg-table" id="@tableId">
            <thead>
                <tr>
                    <th style="width:4%">#</th>
                    @if (showPatient)
                    {
                        <th style="width:8%">Bed</th>
                        <th style="width:12%">Patient</th>
                    }
                    <th style="width:20%">Item Name</th>
                    <th style="width:8%">@(Model?.DoseColumnLabel ?? "Dose")</th>
                    <th style="width:10%">Route</th>
                    <th style="width:14%">Remarks</th>
                    <th style="width:12%">Requested</th>
                    <th style="width:12%">Requested By</th>
                    <th style="width:10%">Status</th>
                    <th style="width:5%">Ack</th>
                    <th style="width:10%">Charged By</th>
                    @if (showPatient)
                    {
                        <th style="width:8%">Form</th>
                    }
                </tr>
            </thead>
            <tbody id="@bodyId">
                @if (!orders.Any())
                {
                    <tr>
                        <td colspan="@colCount" class="text-center text-muted py-3">
                            No @(Model?.Title?.ToLowerInvariant() ?? "orders")@(showPatient ? "" : " for this patient") yet.
                        </td>
                    </tr>
                }
                else
                {
                    var n = 0;
                    foreach (var order in orders)
                    {
                        n++;
                        var isDeleted = order.IsDeleted;
                        var rowClass = isDeleted || order.Discontinue
                            ? "pharmacy-pkg-row-discontinued"
                            : order.IsPharmacyCharged
                                ? "pharmacy-pkg-row-charged"
                                : "pharmacy-pkg-row-pending";
                        var searchText = string.Join(" ",
                            order.BedNo ?? "",
                            order.MrNo ?? "",
                            order.PatientName ?? "",
                            order.ItemName ?? "",
                            order.Dose ?? "").ToLowerInvariant();

                        <tr class="pharmacy-pkg-row pharmacy-pkg-data-row @rowClass"
                            data-id="@order.Id"
                            data-patient-id="@order.PatientId"
                            data-discontinued="@(order.Discontinue ? "1" : "0")"
                            data-pharmacy-charged="@(order.IsPharmacyCharged ? "1" : "0")"
                            data-deleted="@(isDeleted ? "1" : "0")"
                            data-filter-status="@order.WorkQueueFilterStatus"
                            data-search="@searchText">
                            <td>@n</td>
                            @if (showPatient)
                            {
                                <td class="small">@(order.BedNo ?? "-")</td>
                                <td class="small">
                                    <strong>@(order.PatientName ?? "-")</strong>
                                    @if (!string.IsNullOrWhiteSpace(order.MrNo))
                                    {
                                        <div class="text-muted">@order.MrNo</div>
                                    }
                                </td>
                            }
                            <td>@order.ItemName</td>
                            <td>@(string.IsNullOrWhiteSpace(order.Dose) ? "-" : order.Dose)</td>
                            <td>@(string.IsNullOrWhiteSpace(order.DrugRouteName) ? "-" : order.DrugRouteName)</td>
                            <td>@(string.IsNullOrWhiteSpace(order.Remarks) ? "-" : order.Remarks)</td>
                            <td class="small">@order.RequestedOn.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td class="small">@(order.RequestedByName ?? "-")</td>
                            <td class="pharmacy-pkg-status small fw-semibold">
                                @if (isDeleted || order.Discontinue)
                                {
                                    <span class="text-danger">Cancelled</span>
                                }
                                else if (order.IsPharmacyCharged)
                                {
                                    <span class="text-success">Completed</span>
                                }
                                else
                                {
                                    <span class="text-warning">Pending</span>
                                }
                            </td>
                            <td class="text-center pharmacy-pkg-ack-cell">
                                @if (isDeleted || order.Discontinue)
                                {
                                    <span class="text-danger small">N/A</span>
                                }
                                else if (order.IsPharmacyCharged)
                                {
                                    <span class="text-success small">&#10003;</span>
                                }
                                else if (canWork)
                                {
                                    <input type="checkbox"
                                           class="form-check-input pharmacy-pkg-ack-checkbox mt-1"
                                           title="Acknowledge / charge item" />
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="pharmacy-pkg-ack-by small">
                                @if (order.IsPharmacyCharged)
                                {
                                    @(order.AckByName ?? "-")
                                    if (order.AckDate.HasValue)
                                    {
                                        <div class="text-muted">@order.AckDate.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            @if (showPatient)
                            {
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(order.PatientId))
                                    {
                                        @Html.ActionLink(
                                            "View Form",
                                            "ErForm",
                                            "EmergencyForm",
                                            new { patientId = order.PatientId, returnTo = "pharmacy" },
                                            new { @class = "btn btn-sm btn-outline-danger" })
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
