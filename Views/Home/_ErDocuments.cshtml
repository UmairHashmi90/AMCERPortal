@{
    bool canEdit = ViewBag.CanUploadDocuments == true;
    var documents = ViewBag.ReviewFormDocuments as IEnumerable<ERPaperless.Models.DocumentRowViewModel>
                    ?? Enumerable.Empty<ERPaperless.Models.DocumentRowViewModel>();
    var documentTypeOptions = ViewBag.DocumentTypeOptions as IEnumerable<ERPaperless.Models.ERLovOptionViewModel>
                              ?? Enumerable.Empty<ERPaperless.Models.ERLovOptionViewModel>();
    var docList = documents
        .OrderByDescending(x => x.UploadedOn)
        .ToList();
}

<section class="panel-card">
    <h3>
        Documents
        @if (!canEdit) { <small class="text-muted fw-normal">(upload: MO/Nursing only)</small> }
    </h3>

    @if (canEdit)
    {
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-start mb-3 doc-upload-row">
            <div class="col-md-8">
                <label class="form-label">Upload Document</label>
                <input type="file" class="form-control" id="docUploadInput"
                       accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                <input type="file" id="docCameraInput" accept="image/*" capture="environment" style="display:none;" />
                <div class="doc-upload-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPickCameraDoc">Camera</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPickGalleryDoc">Gallery / Files</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnUploadDoc">Upload</button>
                </div>
                <div class="form-text">PDF, JPG, PNG, Word - max 10 MB each.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="docTypeSearch">Document Type</label>
                <input type="search" id="docTypeSearch" class="form-select searchable-dropdown"
                       list="docTypeOptions" autocomplete="off" placeholder="Search document type..." />
                <datalist id="docTypeOptions">
                    @foreach (var option in documentTypeOptions)
                    {
                        <option value="@option.Name"></option>
                    }
                </datalist>
            </div>
        </div>

        <div class="modal fade" id="docCameraModal" tabindex="-1" aria-labelledby="docCameraModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="docCameraModalLabel">Capture Document</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <video id="docCameraVideo" autoplay playsinline
                               style="width:100%;max-height:55vh;background:#111;border-radius:10px;"></video>
                        <canvas id="docCameraCanvas" style="display:none;"></canvas>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger btn-sm" id="btnTakeDocPhoto">Take Photo & Upload</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="table-wrap grid-max-7">
        <table class="app-table" id="documentsTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>File Name</th>
                    <th>Type</th>
                    <th>Uploaded By</th>
                    <th>Date</th>
                    @if (canEdit) { <th></th> }
                </tr>
            </thead>
            <tbody id="documentsBody">
                @if (!docList.Any())
                {
                    <tr id="docPlaceholder">
                        <td colspan="@(canEdit ? 6 : 5)" class="text-center text-muted py-3">No documents uploaded.</td>
                    </tr>
                }
                else
                {
                    var n = 0;
                    foreach (var doc in docList)
                    {
                        n++;
                        <tr class="doc-data-row" data-id="@doc.Id">
                            <td>@n</td>
                            <td>
                                <a href="@Url.Action("DownloadDocument", "EmergencyForm", new { documentId = doc.Id, patientId = ViewBag.ErPatientId })">@doc.FileName</a>
                            </td>
                            <td>@(doc.DocumentType ?? "-")</td>
                            <td>@(doc.UploadedByName ?? "-")</td>
                            <td>@doc.UploadedOn.ToString("dd-MMM-yyyy HH:mm")</td>
                            @if (canEdit)
                            {
                                <td class="text-center">
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 doc-remove-btn" title="Remove">&#x2715;</button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
