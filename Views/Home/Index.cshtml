@model ERPaperless.Models.DashboardViewModel
@{
    ViewBag.Title = "ER Dashboard";
    var cards = Model?.Cards ?? new System.Collections.Generic.List<ERPaperless.Models.KpiCardViewModel>();
}

<section class="page-section dashboard-page">
    <div class="section-head d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h2 class="mb-1">ER Dashboard</h2>
            <p class="mb-0 text-muted">Live operational counts from ER Portal.</p>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Patients", "Home")">All Patients</a>
    </div>

    <div class="kpi-grid">
        @if (cards.Count == 0)
        {
            <article class="kpi-card tone-primary">
                <p class="kpi-title">No data</p>
                <h3 class="kpi-value">0</h3>
                <p class="kpi-subtitle">Dashboard procedure returned no rows.</p>
            </article>
        }
        else
        {
            foreach (var card in cards)
            {
                @Html.Partial("_KpiCard", card)
            }
        }
    </div>
</section>
