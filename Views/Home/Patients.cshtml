@model IEnumerable<ERPaperless.Models.LocationCardViewModel>
@{
    ViewBag.Title = "Patients";
}

@* ── Toast notifications ─────────────────────────────────────────────────── *@
@if (TempData["AccessError"] != null)
{
    <div class="alert alert-warning alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Access Denied:</strong> @TempData["AccessError"]
    </div>
}
@if (TempData["AssignSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Success!</strong> @TempData["AssignSuccess"]
    </div>
}
@if (TempData["AssignError"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Error:</strong> @TempData["AssignError"]
    </div>
}

<section class="page-section">

    <div class="toolbar-row patients-toolbar">
        <input type="text" class="form-control quick-input"
               id="bedSearch" placeholder="Search by Name / MR No / Bed" />
        <div class="patients-module-actions">
            @if (ViewBag.IsMO == true || ViewBag.IsNursing == true)
            {
                @Html.ActionLink("Discharged Patients", "DischargedPatients", "Home", null,
                         new { @class = "btn btn-sm patient-form-nav-btn btn-outline-danger" })
            }
            @if (ViewBag.IsPharmacy == true)
            {
                @Html.ActionLink("Pharmacy", "PatientForm", "Pharmacy", null,
                         new { @class = "btn btn-sm patient-form-nav-btn btn-outline-danger" })
            }
            @if (ViewBag.IsBilling == true)
            {
                @Html.ActionLink("Billing", "PatientForm", "Billing", null,
                         new { @class = "btn btn-sm patient-form-nav-btn btn-outline-danger" })
            }
           
        </div>
        <div class="legend-inline">
            <span class="status-chip status-red">Occupied</span>
            <span class="status-chip status-orange">Pending MR</span>
            <span class="status-chip status-green">Available</span>
            <span class="status-chip status-purple">Housekeeping</span>
            <span class="status-chip status-gray">Closed</span>
        </div>
    </div>

    <div class="location-grid" id="locationGrid">
        @Html.Partial("_LocationGrid", Model)
    </div>
</section>

<input type="hidden" id="cancelPendingMrUrl" value="@Url.Action("CancelPendingMr", "Home")" />
<input type="hidden" id="patientsGridUrl" value="@Url.Action("PatientsGrid", "Home")" />

@* ══════════════════════════════════════════════════════════════════════════
   Pending MR Confirmation Modal – fires when View Form clicked on a free bed
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="pendingMrModal" tabindex="-1" role="dialog"
     aria-labelledby="pendingMrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            @using (Html.BeginForm("MarkBedPending", "Home", FormMethod.Post,
                    new { id = "frmPendingMr" }))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" id="pmBedId"      name="bedId"          value="0" />
                <input type="hidden" id="pmBranchCode" name="branchCode"     value="0" />

                <div class="modal-header">
                    <h4 class="modal-title" id="pendingMrModalLabel">
                        Open Bed for Patient
                    </h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        <strong><span id="pmBedNameSpan"></span></strong>
                        is currently
                        <span class="text-muted" id="pmStatusSpan"></span>.
                    </p>
                    <p>
                        Are you sure you want to open this bed for an
                        <strong>emergency patient</strong>?
                    </p>
                    <div class="form-group">
                        <label for="pmPatientName">Patient Name <small class="text-muted">(optional)</small></label>
                        <input type="text"
                               class="form-control"
                               id="pmPatientName"
                               name="patientName"
                               maxlength="100"
                               placeholder="Leave blank to use bed name" />
                    </div>
                    <p class="text-muted small mb-0">
                        The bed status will be set to <strong>Pending MR</strong>
                        and the ER Form will open immediately.
                        Patient details can be entered in the form.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default"
                            data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        Yes, Open Bed
                    </button>
                </div>
            }

        </div>
    </div>
</div>

<div class="modal fade" id="cancelPendingMrModal" tabindex="-1" role="dialog"
     aria-labelledby="cancelPendingMrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="cancelPendingMrModalLabel">Cancel Pending MR</h4>
                <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>
                    Cancel Pending MR for
                    <strong><span id="cpmPatientNameSpan"></span></strong>
                    on <strong><span id="cpmBedNameSpan"></span></strong>?
                </p>
                <p class="text-muted small mb-0">
                    This removes the pending patient and sets the bed back to Available.
                </p>
                <input type="hidden" id="cpmBedId" value="0" />
                <input type="hidden" id="cpmBranchCode" value="0" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" id="cpmConfirmBtn">Yes, Cancel</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function showPatientsToast(message, isError) {
        var host = document.getElementById("patientsToastHost");
        if (!host) {
            host = document.createElement("div");
            host.id = "patientsToastHost";
            var section = document.querySelector(".page-section");
            if (section) section.insertBefore(host, section.firstChild);
        }
        host.innerHTML = '<div class="alert ' + (isError ? 'alert-danger' : 'alert-success') +
            ' alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>' +
            (message || "") + "</div>";
    }

    function showModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        if (window.jQuery && typeof window.jQuery.fn.modal === "function") {
            window.jQuery("#" + id).modal("show");
            return;
        }
        if (window.bootstrap && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(el).show();
        }
    }

    function hideModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        if (window.jQuery && typeof window.jQuery.fn.modal === "function") {
            window.jQuery("#" + id).modal("hide");
            return;
        }
        if (window.bootstrap && bootstrap.Modal) {
            var instance = bootstrap.Modal.getInstance(el);
            if (instance) instance.hide();
        }
    }

    function refreshLocationGrid() {
        var grid = document.getElementById("locationGrid");
        var urlEl = document.getElementById("patientsGridUrl");
        if (!grid || !urlEl || !urlEl.value) return Promise.resolve();
        return fetch(urlEl.value, { credentials: "same-origin" })
            .then(function (res) { return res.text(); })
            .then(function (html) { grid.innerHTML = html; });
    }

    document.getElementById("bedSearch").addEventListener("keyup", function () {
        var term = this.value.toLowerCase();
        document.querySelectorAll("#locationGrid .location-card").forEach(function (card) {
            card.style.display = card.textContent.toLowerCase().indexOf(term) >= 0 ? "" : "none";
        });
    });

    document.getElementById("locationGrid").addEventListener("click", function (e) {
        var openBtn = e.target.closest(".open-bed-btn");
        if (openBtn) {
            document.getElementById("pmBedId").value = openBtn.getAttribute("data-bedid");
            document.getElementById("pmBranchCode").value = openBtn.getAttribute("data-branchcode");
            document.getElementById("pmBedNameSpan").textContent = openBtn.getAttribute("data-bedname");
            document.getElementById("pmStatusSpan").textContent = openBtn.getAttribute("data-status");
            document.getElementById("pmPatientName").value = "";
            showModal("pendingMrModal");
            return;
        }

        var binBtn = e.target.closest(".cancel-pending-mr-btn");
        if (binBtn) {
            document.getElementById("cpmBedId").value = binBtn.getAttribute("data-bedid") || "0";
            document.getElementById("cpmBranchCode").value = binBtn.getAttribute("data-branchcode") || "0";
            document.getElementById("cpmBedNameSpan").textContent = binBtn.getAttribute("data-bedname") || "";
            document.getElementById("cpmPatientNameSpan").textContent = binBtn.getAttribute("data-patientname") || "";
            showModal("cancelPendingMrModal");
        }
    });

    var confirmBtn = document.getElementById("cpmConfirmBtn");
    if (confirmBtn) {
        confirmBtn.addEventListener("click", function () {
            var urlEl = document.getElementById("cancelPendingMrUrl");
            var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!urlEl || !urlEl.value) return;

            var formData = new FormData();
            formData.append("bedId", document.getElementById("cpmBedId").value || "0");
            formData.append("branchCode", document.getElementById("cpmBranchCode").value || "0");
            if (tokenEl) formData.append("__RequestVerificationToken", tokenEl.value);

            confirmBtn.disabled = true;
            fetch(urlEl.value, {
                method: "POST",
                body: formData,
                credentials: "same-origin",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (res) { return res.json(); })
                .then(function (result) {
                    if (!result || !result.ok) throw new Error((result && result.message) || "Could not cancel Pending MR.");
                    hideModal("cancelPendingMrModal");
                    return refreshLocationGrid().then(function () {
                        showPatientsToast(result.message || "Pending MR cancelled.", false);
                    });
                })
                .catch(function (err) {
                    showPatientsToast(err.message || "Could not cancel Pending MR.", true);
                })
                .then(function () {
                    confirmBtn.disabled = false;
                });
        });
    }
</script>
}
